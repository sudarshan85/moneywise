# MoneyWise Environment Variables
# Copy this file to .env and fill in your values

# Password for accessing the app (required for hosted deployment)
# Leave unset for local development without password protection
MONEYWISE_PASSWORD=your-secure-password-here

# Bearer token for the MCP endpoint (POST /mcp). Unset = endpoint disabled.
# In production this is a Fly secret; mcp/.env holds the same value.
MCP_TOKEN=
